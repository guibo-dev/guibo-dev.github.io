---
import BaseLayout from '../layouts/BaseLayout.astro';
import StatStrip from '../components/StatStrip.astro';
import SectionTier from '../components/SectionTier.astro';
import ProjectCard from '../components/ProjectCard.astro';
import MediaSlot from '../components/MediaSlot.astro';
import { PARTNERS } from '../data/partners';
import { TIER_ORDER, getOrderedProjects } from '../lib/projects';
import { SITE_NAME, SITE_DESCRIPTION, CONTACT_EMAIL, LINKEDIN_URL } from '../config';

const ordered = await getOrderedProjects();
const byTier = TIER_ORDER.map((tier) => ({
  tier,
  projects: ordered.filter((p) => p.data.tier === tier),
})).filter((group) => group.projects.length > 0);

const portfolioStats = [
  { value: '$250K', label: 'portfolio managed' },
  { value: '130k+', label: 'podcast listeners (5× over target)' },
  { value: '1M+', label: 'views generated across campaigns' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE_NAME,
  email: `mailto:${CONTACT_EMAIL}`,
  description: SITE_DESCRIPTION,
  url: Astro.site?.toString(),
  ...(LINKEDIN_URL ? { sameAs: [LINKEDIN_URL] } : {}),
};
---

<BaseLayout title={`${SITE_NAME} — Portfolio`} description={SITE_DESCRIPTION} jsonLd={jsonLd}>
  <!-- 1.1 Hero + Intro -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">{SITE_NAME}</p>
        <p class="greeting">Hey I&rsquo;m Guille,</p>
        <h1>
          Over the last three years I&rsquo;ve gone from marketing intern to running a $250K
          portfolio spanning the launch of a flagship podcast, an annual out-of-home marketing
          campaign in Oslo, and a global comedy event series.
        </h1>
        <p class="supporting">
          Working at a global nonprofit has taught me to deliver on time and on budget with far
          less than most teams have and to build the processes and partnerships that let
          campaigns scale and break through. I thrive where operations, partnerships, and
          creativity meet, and I&rsquo;m looking to bring that discipline to a company building
          something people genuinely rely on.
        </p>
        <div class="hero-ctas">
          <a class="btn btn-primary" href="#work">Explore my work</a>
          <a class="btn btn-secondary" href="#contact">Get in touch</a>
        </div>
      </div>
      <div class="hero-portrait">
        <MediaSlot
          folder="headshot"
          file="headshot-portrait-01"
          alt={`Professional portrait of ${SITE_NAME}`}
          ratio="4 / 5"
          loading="eager"
        />
      </div>
    </div>
  </section>

  <StatStrip items={portfolioStats} />

  <!-- 1.2 Project Index -->
  <section class="work container" id="work" aria-label="Project index">
    <h2>Featured Campaigns</h2>
    {
      byTier.map((group) => (
        <SectionTier title={group.tier} featured={group.tier === 'Flagship Campaigns'}>
          {group.projects.map((p) => (
            <ProjectCard
              slug={p.data.slug}
              title={p.data.title}
              descriptor={p.data.descriptor}
              roleTag={p.data.role_tag}
              thumbnail={(() => {
                const t = p.data.thumbnail ?? p.data.hero;
                return t ? { folder: t.folder, file: t.file, alt: t.alt } : undefined;
              })()}
            />
          ))}
        </SectionTier>
      ))
    }
  </section>

  <!-- Section 6 — Partners -->
  <section class="partners container" aria-label="Partners">
    <h2>Partners</h2>
    <ul class="logo-wall">
      {
        PARTNERS.map((partner) => (
          <li data-reveal>
            <a href={partner.url} target="_blank" rel="noopener noreferrer">
              <MediaSlot folder="partners" file={partner.file} alt={`${partner.name} logo`} />
              <span class="partner-line">{partner.name}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-5);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: var(--space-4);
    align-items: center;
  }

  .hero .eyebrow {
    color: var(--ink);
  }

  /* Greeting, headline, and supporting copy share one body-text voice */
  .greeting,
  h1,
  .supporting {
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.5vw, 1.15rem);
    font-weight: 400;
    line-height: 1.65;
    letter-spacing: normal;
    color: var(--ink-soft);
    max-width: 58ch;
    text-wrap: initial;
  }

  h1 {
    margin-bottom: var(--space-2);
  }

  .greeting {
    margin-bottom: var(--space-2);
  }

  .hero-ctas {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
    margin-top: var(--space-3);
  }

  /* Portrait above headline on mobile */
  @media (max-width: 48rem) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .hero-portrait {
      order: -1;
      max-width: 16rem;
    }
  }

  .work {
    padding-top: var(--space-5);
  }

  .work h2,
  .partners h2 {
    font-size: var(--text-section);
  }

  .partners {
    padding-top: var(--space-4);
  }

  .logo-wall {
    list-style: none;
    padding: 0;
    margin: var(--space-3) 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
    gap: var(--space-3) var(--space-2);
    max-width: none;
  }

  .logo-wall li {
    margin: 0;
  }

  .logo-wall a {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    text-decoration: none;
    border-radius: var(--radius);
  }

  /* Grayscale wall, color on hover; logos breathe inside bordered tiles */
  .logo-wall li :global(img) {
    filter: grayscale(1);
    opacity: 0.8;
    transition: filter 0.2s ease, opacity 0.2s ease;
    object-fit: contain;
    aspect-ratio: 3 / 2;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.1rem 1.35rem;
  }

  .logo-wall li:hover :global(img) {
    filter: none;
    opacity: 1;
  }

  .partner-line {
    font-size: 0.82rem;
    font-weight: 600;
    line-height: 1.5;
    color: var(--ink);
  }

  .logo-wall a:hover .partner-line {
    color: var(--accent-dark);
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 3px;
  }
</style>
