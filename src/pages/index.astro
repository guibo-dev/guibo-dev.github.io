---
import BaseLayout from '../layouts/BaseLayout.astro';
import StatStrip from '../components/StatStrip.astro';
import SectionTier from '../components/SectionTier.astro';
import ProjectCard from '../components/ProjectCard.astro';
import MediaSlot from '../components/MediaSlot.astro';
import { PARTNERS, TOOL_CATEGORIES } from '../data/partners';
import { EXPERIENCE, EDUCATION } from '../data/career';
import { TIER_ORDER, getOrderedProjects } from '../lib/projects';
import { SITE_NAME, SITE_DESCRIPTION, CONTACT_EMAIL, LINKEDIN_URL } from '../config';

const ordered = await getOrderedProjects();
const byTier = TIER_ORDER.map((tier) => ({
  tier,
  projects: ordered.filter((p) => p.data.tier === tier),
})).filter((group) => group.projects.length > 0);

const portfolioStats = [
  { value: '$250K', label: 'portfolio managed' },
  { value: '130k+', label: 'podcast listeners (5× over target)' },
  { value: '1M+', label: 'engagements generated across campaigns' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE_NAME,
  email: `mailto:${CONTACT_EMAIL}`,
  description: SITE_DESCRIPTION,
  url: Astro.site?.toString(),
  ...(LINKEDIN_URL ? { sameAs: [LINKEDIN_URL] } : {}),
};
---

<BaseLayout title={`${SITE_NAME} — Portfolio`} description={SITE_DESCRIPTION} jsonLd={jsonLd}>
  <!-- 1.1 Hero + Intro -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="hero-role">Marketing Specialist · Human Rights Foundation</p>
        <h1 class="greeting">Hey, I&rsquo;m Guille.</h1>
        <div class="intro">
          <p>
            The best compliment I&rsquo;ve ever received at work came from someone who&rsquo;d been
            furious with me a few days earlier. Her event app kept glitching, and she wasn&rsquo;t
            shy about telling me. Later that week she found me after a comedy show I&rsquo;d produced,
            grinning ear to ear: &ldquo;My new favorite thing is to laugh at dictators.&rdquo;
          </p>
          <p>
            That show started as an idea nobody asked me for. A stand-up night taking on dictators,
            with comedians from places where that joke can get you arrested. I pitched it, my boss
            didn&rsquo;t say no, and I spent the next year turning an idea into a stage: finding the
            venue, signing the talent, selling the tickets, and holding my nerve when one comedian
            sent over a set so far over the line I had to trust him to know his own craft. He did.
            Three hundred people gave him a standing ovation.
          </p>
          <p>
            That&rsquo;s what I like most about marketing: taking an idea, finding the right people,
            and building the thing that turns it into something people actually remember.
          </p>
          <p>
            I&rsquo;ve spent three years doing that at the Human Rights Foundation. Launched a
            flagship podcast that beat its target fivefold, built with a host, a production team, and
            a strategist I leaned on hard. Ran an out-of-home campaign in Oslo across partners,
            creatives, and vendors who all needed to move at once. Built a comedy series from
            nothing.
          </p>
          <p>
            None of it came from a big budget. It came from a bold idea, a hundred quiet decisions no
            one sees, and the people I chose to build alongside. That&rsquo;s where I&rsquo;m at my
            best, sitting between the creative idea and everything it takes to make it real.
          </p>
          <p>Take a look around. I&rsquo;d love to tell you the rest.</p>
        </div>
      </div>
      <div class="hero-portrait">
        <MediaSlot
          folder="headshot"
          file="headshot-portrait-01"
          alt={`Professional portrait of ${SITE_NAME}`}
          ratio="4 / 5"
          loading="eager"
        />
        <div class="hero-ctas">
          <a class="btn btn-primary" href="#work">Explore my work</a>
          <a class="btn btn-secondary" href="#contact">Get in touch</a>
        </div>
      </div>
    </div>
  </section>

  <StatStrip items={portfolioStats} />

  <!-- 1.15 Experience & Education -->
  <section class="career container" aria-label="Experience and education">
    {
      [
        { label: 'Experience', items: EXPERIENCE },
        { label: 'Education', items: EDUCATION },
      ].map((group) => (
        <div class="career-group">
          <h2>{group.label}</h2>
          <ul class="career-list">
            {group.items.map((item) => (
              <li data-reveal>
                <a
                  class:list={['c-logo', { dark: item.dark }]}
                  href={item.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${item.org} — opens in a new tab`}
                >
                  <MediaSlot folder="career" file={item.logo} alt={`${item.org} logo`} ratio="1 / 1" />
                </a>
                <span class="c-body">
                  <span class="c-head">
                    <span class="c-role">
                      {item.role}
                      {item.note && <span class="c-note">{item.note}</span>}
                    </span>
                    <span class="c-dates">{item.dates}</span>
                  </span>
                  <span class="c-org">
                    {item.org} · {item.location}
                  </span>
                  <span class="c-desc">{item.description}</span>
                </span>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </section>

  <!-- 1.2 Project Index -->
  <section class="work container" id="work" aria-label="Project index">
    {
      byTier.map((group) => (
        <SectionTier title={group.tier} featured={group.tier === 'Flagship Campaigns'}>
          {group.projects.map((p) => (
            <ProjectCard
              slug={p.data.slug}
              title={p.data.title}
              descriptor={p.data.descriptor}
              roleTag={p.data.role_tag}
              thumbnail={(() => {
                const t = p.data.thumbnail ?? p.data.hero;
                return t ? { folder: t.folder, file: t.file, alt: t.alt } : undefined;
              })()}
            />
          ))}
        </SectionTier>
      ))
    }
  </section>

  <!-- Section 6 — Partners -->
  <section class="partners container" aria-label="Partners">
    <h2>Partners</h2>
    <ul class="logo-wall">
      {
        PARTNERS.map((partner) => (
          <li data-reveal>
            <a href={partner.url} target="_blank" rel="noopener noreferrer">
              <MediaSlot folder="partners" file={partner.file} alt={`${partner.name} logo`} />
              <span class="partner-line">{partner.name}</span>
            </a>
          </li>
        ))
      }
    </ul>

    {
      TOOL_CATEGORIES.map((category) => (
        <div class="tool-category">
          <h3>{category.title}</h3>
          <ul class="logo-wall compact">
            {category.items.map((tool) => (
              <li data-reveal>
                <a href={tool.url} target="_blank" rel="noopener noreferrer">
                  <MediaSlot folder="partners" file={tool.file} alt={`${tool.name} logo`} />
                  <span class="partner-line">{tool.name}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-5);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: var(--space-4);
    align-items: start;
  }

  /* Current-role label: instant professional context above the greeting */
  .hero-role {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-bottom: var(--space-2);
  }

  /* The greeting is the hero's single display-scale hook */
  .greeting {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-weight: 600;
    font-size: clamp(1.9rem, 3.6vw, 2.7rem);
    line-height: 1.1;
    letter-spacing: -0.018em;
    color: var(--ink);
    margin-bottom: var(--space-3);
  }

  /* Narrative intro paragraphs share one body-text voice */
  .intro p {
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.5vw, 1.15rem);
    font-weight: 400;
    line-height: 1.65;
    letter-spacing: normal;
    color: var(--ink-soft);
    max-width: 58ch;
    margin-bottom: var(--space-2);
  }

  .intro p:last-child {
    margin-bottom: 0;
  }

  .hero-ctas {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
    margin-top: var(--space-3);
  }

  /* Portrait above headline on mobile */
  @media (max-width: 48rem) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .hero-portrait {
      order: -1;
      max-width: 16rem;
    }
  }

  /* Experience & Education — editorial rail, matching the case-study blocks */
  .career {
    padding-top: var(--space-5);
  }

  .career-group {
    margin-block: var(--space-4);
  }

  .career-group h2 {
    font-size: 1.3rem;
  }

  @media (min-width: 64rem) {
    .career-group {
      display: grid;
      grid-template-columns: 13rem minmax(0, 1fr);
      column-gap: var(--space-4);
      align-items: start;
    }

    .career-group h2 {
      margin-bottom: 0;
      position: sticky;
      top: var(--space-3);
    }
  }

  .career-list {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .career-list li {
    margin: 0;
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
  }

  .c-logo {
    flex: 0 0 4.25rem;
    display: block;
    border-radius: var(--radius);
  }

  .c-logo :global(img) {
    width: 4.25rem;
    height: 4.25rem;
    object-fit: contain;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 0.6rem;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .c-logo:hover :global(img) {
    border-color: var(--accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .c-logo:hover :global(img) {
      transform: translateY(-2px);
    }
  }

  .c-logo.dark :global(img) {
    background: #111;
    border-color: #111;
    padding: 0.7rem;
  }

  .c-body {
    flex: 1;
    min-width: 0;
  }

  .c-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .c-role {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-weight: 600;
    font-size: 1.12rem;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .c-note {
    font-family: var(--font-body);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-soft);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.1rem 0.5rem;
    margin-left: 0.5rem;
    vertical-align: middle;
    white-space: nowrap;
  }

  .c-dates {
    font-size: 0.85rem;
    color: var(--ink-soft);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .c-org {
    display: block;
    font-size: 0.92rem;
    font-weight: 550;
    color: var(--ink);
    margin-top: 0.15rem;
  }

  .c-desc {
    display: block;
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--ink-soft);
    margin-top: 0.4rem;
    max-width: 58ch;
  }

  @media (max-width: 40rem) {
    .c-logo {
      flex-basis: 3.25rem;
    }
    .c-logo :global(img) {
      width: 3.25rem;
      height: 3.25rem;
      padding: 0.45rem;
    }
  }

  .work {
    padding-top: var(--space-5);
  }

  .partners h2 {
    font-size: var(--text-section);
  }

  .partners {
    padding-top: var(--space-4);
  }

  /* Tool categories reuse the Partners logo wall beneath it */
  .tool-category {
    margin-top: var(--space-5);
  }

  .tool-category h3 {
    font-size: 1.3rem;
  }

  .logo-wall {
    list-style: none;
    padding: 0;
    margin: var(--space-3) 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
    gap: var(--space-3) var(--space-2);
    max-width: none;
  }

  .logo-wall li {
    margin: 0;
  }

  .logo-wall a {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    text-decoration: none;
    border-radius: var(--radius);
  }

  /* Grayscale wall, color on hover; logos breathe inside bordered tiles */
  .logo-wall li :global(img) {
    filter: grayscale(1);
    opacity: 0.8;
    transition: filter 0.2s ease, opacity 0.2s ease;
    object-fit: contain;
    aspect-ratio: 3 / 2;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.1rem 1.35rem;
  }

  .logo-wall li:hover :global(img) {
    filter: none;
    opacity: 1;
  }

  /* Compact skills/tools wall: smaller tiles than the Partners wall */
  .logo-wall.compact {
    grid-template-columns: repeat(auto-fill, minmax(7.5rem, 1fr));
  }

  .logo-wall.compact li :global(img) {
    padding: 0.7rem 0.85rem;
  }

  .logo-wall.compact .partner-line {
    font-size: 0.75rem;
  }

  .partner-line {
    font-size: 0.82rem;
    font-weight: 600;
    line-height: 1.5;
    color: var(--ink);
  }

  .logo-wall a:hover .partner-line {
    color: var(--accent-dark);
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 3px;
  }
</style>
