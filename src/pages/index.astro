---
import BaseLayout from '../layouts/BaseLayout.astro';
import StatStrip from '../components/StatStrip.astro';
import SectionTier from '../components/SectionTier.astro';
import ProjectCard from '../components/ProjectCard.astro';
import MediaSlot from '../components/MediaSlot.astro';
import { PARTNERS, TOOL_CATEGORIES } from '../data/partners';
import { TIER_ORDER, getOrderedProjects } from '../lib/projects';
import { SITE_NAME, SITE_DESCRIPTION, CONTACT_EMAIL, LINKEDIN_URL } from '../config';

const ordered = await getOrderedProjects();
const byTier = TIER_ORDER.map((tier) => ({
  tier,
  projects: ordered.filter((p) => p.data.tier === tier),
})).filter((group) => group.projects.length > 0);

const portfolioStats = [
  { value: '$250K', label: 'portfolio managed' },
  { value: '130k+', label: 'podcast listeners (5× over target)' },
  { value: '1M+', label: 'engagements generated across campaigns' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE_NAME,
  email: `mailto:${CONTACT_EMAIL}`,
  description: SITE_DESCRIPTION,
  url: Astro.site?.toString(),
  ...(LINKEDIN_URL ? { sameAs: [LINKEDIN_URL] } : {}),
};
---

<BaseLayout title={`${SITE_NAME} — Portfolio`} description={SITE_DESCRIPTION} jsonLd={jsonLd}>
  <!-- 1.1 Hero + Intro -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <h1 class="greeting">Hey, I&rsquo;m Guille.</h1>
        <div class="intro">
          <p>
            The best compliment I&rsquo;ve ever received at work came from someone who&rsquo;d been
            furious with me a few days earlier.
          </p>
          <p>
            Her event app kept glitching, and she wasn&rsquo;t shy about telling me. Later that
            week, she found me after a comedy show I&rsquo;d produced, smiling ear to ear, and said,
            &ldquo;My new favorite thing is to laugh at dictators.&rdquo;
          </p>
          <p>
            That moment has stayed with me because it captured what I enjoy most about this work:
            taking an idea and a budget and turning them into something that changes how people
            think or feel, even if only for a moment.
          </p>
          <p>
            I&rsquo;ve spent three years doing that at a global nonprofit, with far less than most
            teams have. Launched a flagship podcast. Ran out-of-home campaigns in Oslo. Built a
            comedy series from nothing.
          </p>
          <p>
            I&rsquo;ve learned that memorable work rarely comes from the biggest budget. More often,
            it&rsquo;s the result of bold ideas, thoughtful decisions that no one notices, and the
            people you choose to build alongside.
          </p>
          <p>
            That&rsquo;s the kind of work I enjoy most: where creativity meets execution, ideas
            become experiences, and the details quietly make all the difference.
          </p>
        </div>
        <div class="hero-ctas">
          <a class="btn btn-primary" href="#work">Explore my work</a>
          <a class="btn btn-secondary" href="#contact">Get in touch</a>
        </div>
      </div>
      <div class="hero-portrait">
        <MediaSlot
          folder="headshot"
          file="headshot-portrait-01"
          alt={`Professional portrait of ${SITE_NAME}`}
          ratio="4 / 5"
          loading="eager"
        />
      </div>
    </div>
  </section>

  <StatStrip items={portfolioStats} />

  <!-- 1.2 Project Index -->
  <section class="work container" id="work" aria-label="Project index">
    {
      byTier.map((group) => (
        <SectionTier title={group.tier} featured={group.tier === 'Flagship Campaigns'}>
          {group.projects.map((p) => (
            <ProjectCard
              slug={p.data.slug}
              title={p.data.title}
              descriptor={p.data.descriptor}
              roleTag={p.data.role_tag}
              thumbnail={(() => {
                const t = p.data.thumbnail ?? p.data.hero;
                return t ? { folder: t.folder, file: t.file, alt: t.alt } : undefined;
              })()}
            />
          ))}
        </SectionTier>
      ))
    }
  </section>

  <!-- Section 6 — Partners -->
  <section class="partners container" aria-label="Partners">
    <h2>Partners</h2>
    <ul class="logo-wall">
      {
        PARTNERS.map((partner) => (
          <li data-reveal>
            <a href={partner.url} target="_blank" rel="noopener noreferrer">
              <MediaSlot folder="partners" file={partner.file} alt={`${partner.name} logo`} />
              <span class="partner-line">{partner.name}</span>
            </a>
          </li>
        ))
      }
    </ul>

    {
      TOOL_CATEGORIES.map((category) => (
        <div class="tool-category">
          <h3>{category.title}</h3>
          <ul class="logo-wall">
            {category.items.map((tool) => (
              <li data-reveal>
                <a href={tool.url} target="_blank" rel="noopener noreferrer">
                  <MediaSlot folder="partners" file={tool.file} alt={`${tool.name} logo`} />
                  <span class="partner-line">{tool.name}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-5);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: var(--space-4);
    align-items: start;
  }

  /* The greeting is the hero's single display-scale hook */
  .greeting {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-weight: 600;
    font-size: clamp(1.9rem, 3.6vw, 2.7rem);
    line-height: 1.1;
    letter-spacing: -0.018em;
    color: var(--ink);
    margin-bottom: var(--space-3);
  }

  /* Narrative intro paragraphs share one body-text voice */
  .intro p {
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.5vw, 1.15rem);
    font-weight: 400;
    line-height: 1.65;
    letter-spacing: normal;
    color: var(--ink-soft);
    max-width: 58ch;
    margin-bottom: var(--space-2);
  }

  .intro p:last-child {
    margin-bottom: 0;
  }

  .hero-ctas {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
    margin-top: var(--space-3);
  }

  /* Portrait above headline on mobile */
  @media (max-width: 48rem) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .hero-portrait {
      order: -1;
      max-width: 16rem;
    }
  }

  .work {
    padding-top: var(--space-5);
  }

  .partners h2 {
    font-size: var(--text-section);
  }

  .partners {
    padding-top: var(--space-4);
  }

  /* Tool categories reuse the Partners logo wall beneath it */
  .tool-category {
    margin-top: var(--space-5);
  }

  .tool-category h3 {
    font-size: 1.3rem;
  }

  .logo-wall {
    list-style: none;
    padding: 0;
    margin: var(--space-3) 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
    gap: var(--space-3) var(--space-2);
    max-width: none;
  }

  .logo-wall li {
    margin: 0;
  }

  .logo-wall a {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    text-decoration: none;
    border-radius: var(--radius);
  }

  /* Grayscale wall, color on hover; logos breathe inside bordered tiles */
  .logo-wall li :global(img) {
    filter: grayscale(1);
    opacity: 0.8;
    transition: filter 0.2s ease, opacity 0.2s ease;
    object-fit: contain;
    aspect-ratio: 3 / 2;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.1rem 1.35rem;
  }

  .logo-wall li:hover :global(img) {
    filter: none;
    opacity: 1;
  }

  .partner-line {
    font-size: 0.82rem;
    font-weight: 600;
    line-height: 1.5;
    color: var(--ink);
  }

  .logo-wall a:hover .partner-line {
    color: var(--accent-dark);
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 3px;
  }
</style>
