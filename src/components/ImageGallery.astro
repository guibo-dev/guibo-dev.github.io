---
import MediaSlot from './MediaSlot.astro';

interface Slot {
  file: string;
  alt: string;
  label?: string;
  description?: string;
  type?: 'image' | 'video';
  ratio?: string;
}

interface Props {
  name: string;
  purpose: string;
  folder: string;
  slots: Slot[];
  /** Grid column min-width (e.g. "10.5rem"); shrinks/enlarges grid items. */
  itemMin?: string;
  /** Fixed column count on wider screens (e.g. 4 → two rows of four). */
  columns?: number;
  /** Hide the visible heading (visually a continuation of the prior gallery). */
  hideHeading?: boolean;
}

const { name, purpose, folder, slots, itemMin, columns, hideHeading } = Astro.props;

const gridStyle = [
  itemMin ? `--item-min: ${itemMin};` : '',
  columns ? `--cols: ${columns};` : '',
]
  .join(' ')
  .trim();

// Layout mode follows slot count: single hero, side-by-side pair, grid.
const mode = slots.length === 1 ? 'hero' : slots.length === 2 ? 'pair' : 'grid';
---

{
  slots.length > 0 && (
    <section class:list={['gallery', { continuation: hideHeading }]} aria-label={`${name} gallery`}>
      <h3 class:list={{ 'sr-only': hideHeading }}>{name}</h3>
      <p class="purpose sr-only">{purpose}</p>
      <div class:list={['slots', mode, { 'set-cols': columns }]} style={gridStyle || undefined}>
        {slots.map((slot) => (
          <div class="g-item" data-reveal>
            <MediaSlot
              folder={folder}
              file={slot.file}
              alt={slot.alt}
              label={slot.label}
              description={slot.description}
              type={slot.type}
              ratio={slot.ratio ?? (mode === 'hero' ? '16 / 9' : '3 / 2')}
            />
          </div>
        ))}
      </div>
    </section>
  )
}

<style>
  .gallery {
    margin-block: var(--space-4);
  }

  /* A continuation gallery flows tightly under the previous one */
  .gallery.continuation {
    margin-top: var(--space-2);
  }

  h3 {
    font-size: 1.25rem;
    margin-bottom: var(--space-2);
  }

  .slots {
    display: grid;
    gap: var(--space-2);
  }

  .slots.pair {
    grid-template-columns: repeat(2, 1fr);
  }

  .slots.grid {
    grid-template-columns: repeat(auto-fill, minmax(min(var(--item-min, 14rem), 100%), 1fr));
  }

  /* Fixed column count on wider screens (mobile still reflows below) */
  @media (min-width: 40rem) {
    .slots.grid.set-cols {
      grid-template-columns: repeat(var(--cols, 4), minmax(0, 1fr));
    }
  }

  @media (max-width: 40rem) {
    .slots.pair {
      grid-template-columns: 1fr;
    }
    .slots.grid {
      grid-template-columns: repeat(auto-fill, minmax(min(var(--item-min, 9.5rem), 100%), 1fr));
    }
  }
</style>
