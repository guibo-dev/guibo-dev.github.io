---
/**
 * Native social embed with graceful degradation. Supports:
 *  - X posts        → blockquote upgraded by platform.twitter.com/widgets.js
 *  - Instagram      → blockquote upgraded by instagram.com/embed.js
 *                     (scaled ~0.82 on desktop: IG enforces a 326px minimum,
 *                     the compact grid columns are narrower)
 *  - LinkedIn posts → public-post iframe (no script needed)
 *  - YouTube        → video/playlist iframe (no script needed)
 *  - Spotify        → show/episode player iframe (no script needed)
 *  - Apple Podcasts → show/episode player iframe (no script needed)
 *  - Facebook posts → post-plugin iframe (no script needed)
 *
 * Every variant renders a working styled link immediately; provider scripts
 * are fetched once, lazily, only when an embed nears the viewport. Reserved
 * min-heights keep upgrades from shifting layout badly.
 */
interface Props {
  url: string;
  label: string;
}
const { url, label } = Astro.props;

type Provider = 'x' | 'instagram' | 'linkedin' | 'youtube' | 'spotify' | 'apple' | 'facebook';
const provider: Provider = /instagram\.com\/(p|reels?)\//.test(url)
  ? 'instagram'
  : /linkedin\.com\/posts\//.test(url)
    ? 'linkedin'
    : /youtube\.com\/(watch|playlist)|youtu\.be\//.test(url)
      ? 'youtube'
      : /open\.spotify\.com\//.test(url)
        ? 'spotify'
        : /podcasts\.apple\.com\//.test(url)
          ? 'apple'
          : /facebook\.com\/.+\/posts\//.test(url)
            ? 'facebook'
            : 'x';

// Instagram's embed script only accepts /p/ and /reel/ permalinks; the
// /reels/ viewer form must be normalized or the blockquote never upgrades.
const instagramPermalink = url.replace('instagram.com/reels/', 'instagram.com/reel/');

// LinkedIn public posts embed via an iframe URL derived from the post id
const liMatch = url.match(/(ugcPost|activity)-(\d+)/);
const linkedinSrc = liMatch
  ? `https://www.linkedin.com/embed/feed/update/urn:li:${liMatch[1]}:${liMatch[2]}`
  : null;

// YouTube: single video or playlist
const ytVideo = url.match(/[?&]v=([\w-]+)/) ?? url.match(/youtu\.be\/([\w-]+)/);
const ytList = url.match(/[?&]list=([\w-]+)/);
const youtubeSrc = ytVideo
  ? `https://www.youtube-nocookie.com/embed/${ytVideo[1]}`
  : ytList
    ? `https://www.youtube-nocookie.com/embed/videoseries?list=${ytList[1]}`
    : null;

// Spotify: show / episode / playlist player
const spotifyMatch = url.match(/open\.spotify\.com\/(show|episode|playlist|album|track)\/([A-Za-z0-9]+)/);
const spotifySrc = spotifyMatch
  ? `https://open.spotify.com/embed/${spotifyMatch[1]}/${spotifyMatch[2]}`
  : null;

// Apple Podcasts: same path on the embed subdomain
const appleSrc = /podcasts\.apple\.com\//.test(url)
  ? url.replace('://podcasts.apple.com', '://embed.podcasts.apple.com').split('?')[0]
  : null;

// Facebook: public post plugin
const facebookSrc = `https://www.facebook.com/plugins/post.php?href=${encodeURIComponent(url)}&show_text=true&width=350`;

const iframeSrc =
  provider === 'linkedin'
    ? linkedinSrc
    : provider === 'youtube'
      ? youtubeSrc
      : provider === 'spotify'
        ? spotifySrc
        : provider === 'apple'
          ? appleSrc
          : provider === 'facebook'
            ? facebookSrc
            : null;
---

<div class:list={['evidence-embed', provider]} data-evidence-embed data-provider={provider}>
  {
    provider === 'x' && (
      <blockquote class="twitter-tweet" data-dnt="true" data-theme="light">
        <a href={url} target="_blank" rel="noopener noreferrer">
          {label} <span aria-hidden="true">&#8599;</span>
        </a>
      </blockquote>
    )
  }
  {
    provider === 'instagram' && (
      <div class="ig-wrap">
        <blockquote
          class="instagram-media"
          data-instgrm-permalink={instagramPermalink}
          data-instgrm-version="14"
        >
          <a href={url} target="_blank" rel="noopener noreferrer">
            {label} <span aria-hidden="true">&#8599;</span>
          </a>
        </blockquote>
      </div>
    )
  }
  {
    (provider === 'linkedin' ||
      provider === 'youtube' ||
      provider === 'spotify' ||
      provider === 'apple' ||
      provider === 'facebook') &&
      (iframeSrc ? (
        <iframe
          src={iframeSrc}
          title={label}
          loading="lazy"
          allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
          allowfullscreen
        />
      ) : (
        <blockquote>
          <a href={url} target="_blank" rel="noopener noreferrer">
            {label} <span aria-hidden="true">&#8599;</span>
          </a>
        </blockquote>
      ))
  }
</div>

<script>
  // Fetch each provider's script once, only when embeds approach the viewport.
  const embeds = document.querySelectorAll('[data-evidence-embed]');
  if (embeds.length > 0 && 'IntersectionObserver' in window) {
    let requested = false;
    const addScript = (src: string) => {
      const script = document.createElement('script');
      script.src = src;
      script.async = true;
      document.head.appendChild(script);
    };
    const io = new IntersectionObserver(
      (entries) => {
        if (requested || !entries.some((e) => e.isIntersecting)) return;
        requested = true;
        if (document.querySelector('[data-provider="x"]')) {
          addScript('https://platform.twitter.com/widgets.js');
        }
        if (document.querySelector('[data-provider="instagram"]')) {
          addScript('https://www.instagram.com/embed.js');
        }
        io.disconnect();
      },
      { rootMargin: '600px 0px' }
    );
    embeds.forEach((el) => io.observe(el));
  }

  // Instagram's embed script occasionally fails to send its resize message,
  // leaving an iframe collapsed to ~1px (a blank frame). Self-heal: after the
  // embeds have had time to size, reload the src of any still-collapsed IG
  // iframe once, which forces Instagram to re-send its height.
  const healInstagram = () => {
    document.querySelectorAll('[data-provider="instagram"] iframe').forEach((el) => {
      const frame = el as HTMLIFrameElement;
      if (frame.clientHeight < 200 && !frame.dataset.healed) {
        frame.dataset.healed = '1';
        frame.src = frame.src;
      }
    });
  };
  if (document.querySelector('[data-provider="instagram"]')) {
    setTimeout(healInstagram, 3500);
    setTimeout(healInstagram, 7000);
  }
</script>

<style>
  .evidence-embed.x {
    min-height: 11rem;
  }

  .evidence-embed.instagram {
    min-height: 18rem;
  }

  /* Instagram's iframe floor is 326px; `zoom` shrinks it into the compact
     columns while reflowing the layout box — no phantom height, no clipping,
     unlike transform: scale. */
  @media (min-width: 64rem) {
    .ig-wrap {
      zoom: 0.78;
    }
  }

  /* Fallback card shown until (or in case) the native embed loads */
  blockquote {
    margin: 0;
    padding: var(--space-2);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  blockquote a {
    font-size: 0.9rem;
    font-weight: 550;
    text-decoration: none;
    color: var(--ink);
  }

  blockquote a:hover {
    color: var(--accent-dark);
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 3px;
  }

  iframe {
    display: block;
    width: 100%;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .linkedin iframe {
    height: 24rem;
  }

  .youtube iframe {
    aspect-ratio: 16 / 9;
    height: auto;
  }

  /* Compact podcast players, matched height so they read as a pair */
  .spotify iframe,
  .apple iframe {
    height: 11rem;
  }

  .facebook iframe {
    height: 24rem;
    max-width: 350px;
  }
</style>
