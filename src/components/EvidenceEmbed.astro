---
/**
 * Native social embed with graceful degradation. Supports:
 *  - X posts        → blockquote upgraded by platform.twitter.com/widgets.js
 *  - Instagram      → blockquote upgraded by instagram.com/embed.js
 *  - LinkedIn posts → public-post iframe (no script needed)
 *
 * Every variant renders a working styled link immediately; provider scripts
 * are fetched once, lazily, only when an embed nears the viewport. Reserved
 * min-heights keep the upgrade from shifting layout badly.
 */
interface Props {
  url: string;
  label: string;
}
const { url, label } = Astro.props;

type Provider = 'x' | 'instagram' | 'linkedin';
const provider: Provider = /instagram\.com\/(p|reel)\//.test(url)
  ? 'instagram'
  : /linkedin\.com\/posts\//.test(url)
    ? 'linkedin'
    : 'x';

// LinkedIn public posts embed via an iframe URL derived from the post id
const liMatch = url.match(/(ugcPost|activity)-(\d+)/);
const linkedinSrc = liMatch
  ? `https://www.linkedin.com/embed/feed/update/urn:li:${liMatch[1]}:${liMatch[2]}`
  : null;
---

<div class:list={['evidence-embed', provider]} data-evidence-embed data-provider={provider}>
  {
    provider === 'x' && (
      <blockquote class="twitter-tweet" data-dnt="true" data-theme="light">
        <a href={url} target="_blank" rel="noopener noreferrer">
          {label} <span aria-hidden="true">&#8599;</span>
        </a>
      </blockquote>
    )
  }
  {
    provider === 'instagram' && (
      <blockquote class="instagram-media" data-instgrm-permalink={url} data-instgrm-version="14">
        <a href={url} target="_blank" rel="noopener noreferrer">
          {label} <span aria-hidden="true">&#8599;</span>
        </a>
      </blockquote>
    )
  }
  {
    provider === 'linkedin' &&
      (linkedinSrc ? (
        <iframe src={linkedinSrc} title={label} loading="lazy" allowfullscreen />
      ) : (
        <blockquote>
          <a href={url} target="_blank" rel="noopener noreferrer">
            {label} <span aria-hidden="true">&#8599;</span>
          </a>
        </blockquote>
      ))
  }
</div>

<script>
  // Fetch each provider's script once, only when embeds approach the viewport.
  const embeds = document.querySelectorAll('[data-evidence-embed]');
  if (embeds.length > 0 && 'IntersectionObserver' in window) {
    let requested = false;
    const addScript = (src: string) => {
      const script = document.createElement('script');
      script.src = src;
      script.async = true;
      document.head.appendChild(script);
    };
    const io = new IntersectionObserver(
      (entries) => {
        if (requested || !entries.some((e) => e.isIntersecting)) return;
        requested = true;
        if (document.querySelector('[data-provider="x"]')) {
          addScript('https://platform.twitter.com/widgets.js');
        }
        if (document.querySelector('[data-provider="instagram"]')) {
          addScript('https://www.instagram.com/embed.js');
        }
        io.disconnect();
      },
      { rootMargin: '600px 0px' }
    );
    embeds.forEach((el) => io.observe(el));
  }
</script>

<style>
  .evidence-embed.x {
    min-height: 13rem;
  }

  .evidence-embed.instagram {
    min-height: 24rem;
  }

  /* Fallback card shown until (or in case) the native embed loads */
  blockquote {
    margin: 0;
    padding: var(--space-3);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  blockquote a {
    font-weight: 550;
    text-decoration: none;
    color: var(--ink);
  }

  blockquote a:hover {
    color: var(--accent-dark);
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 3px;
  }

  iframe {
    display: block;
    width: 100%;
    height: 33rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }
</style>
