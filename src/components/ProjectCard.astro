---
import MediaSlot from './MediaSlot.astro';

interface Props {
  slug: string;
  title: string;
  descriptor: string;
  roleTag: string;
  thumbnail?: { folder: string; file: string; alt: string };
}
const { slug, title, descriptor, roleTag, thumbnail } = Astro.props;
---

<article class="project-card" data-reveal>
  {
    thumbnail && (
      <div class="thumb">
        <MediaSlot folder={thumbnail.folder} file={thumbnail.file} alt={thumbnail.alt} ratio="16 / 10" />
      </div>
    )
  }
  <h4><a href={`/work/${slug}/`}>{title}</a></h4>
  <p class="descriptor">{descriptor}</p>
  <p class="role"><span class="pill">{roleTag}</span></p>
</article>

<style>
  .project-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    border-radius: var(--radius);
  }

  .thumb {
    overflow: hidden;
    border-radius: var(--radius);
  }

  h4 {
    font-size: 1.3rem;
    margin: 0.5rem 0 0;
  }

  /* Whole-card click target without nesting interactive elements */
  h4 a {
    color: var(--ink);
    text-decoration: none;
  }

  h4 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .project-card:hover h4 a {
    color: var(--accent-dark);
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 3px;
  }

  .project-card:focus-within {
    outline: 3px solid var(--accent);
    outline-offset: 6px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .thumb :global(img) {
      transition: transform 0.5s var(--ease-out);
    }

    .project-card:hover .thumb :global(img) {
      transform: scale(1.03);
    }
  }

  .descriptor {
    font-size: 0.95rem;
    color: var(--ink-soft);
    margin: 0;
  }

  .role {
    margin: 0.25rem 0 0;
  }
</style>
