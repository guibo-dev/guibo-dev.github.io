---
interface Props {
  caption?: string;
  columns: string[];
  rows: string[][];
}
const { caption, columns, rows } = Astro.props;
---

<div class="table-wrap" tabindex="0" role="region" aria-label={caption ?? 'Data table'}>
  <table>
    {caption && <caption>{caption}</caption>}
    <thead>
      <tr>
        {columns.map((col) => <th scope="col">{col}</th>)}
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <tr>
            {row.map((cell, i) => (i === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>))}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .table-wrap {
    overflow-x: auto;
    margin-block: var(--space-2);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
    min-width: 34rem;
  }

  caption {
    text-align: left;
    font-weight: 600;
    padding: 0.85rem 1rem 0;
  }

  th,
  td {
    text-align: left;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--line);
  }

  thead th {
    font-size: 0.78rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  tbody th {
    font-weight: 600;
  }

  tbody tr:last-child th,
  tbody tr:last-child td {
    border-bottom: none;
  }
</style>
