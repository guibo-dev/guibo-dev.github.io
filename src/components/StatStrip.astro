---
interface Props {
  items: { value: string; label: string }[];
}
const { items } = Astro.props;
---

<dl class="stat-strip">
  {
    items.map((item) => (
      <div class="stat">
        <dt>{item.label}</dt>
        <dd>{item.value}</dd>
      </div>
    ))
  }
</dl>

<style>
  .stat-strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10.5rem, 1fr));
    gap: 1px;
    background: var(--line);
    border-block: 1px solid var(--line);
    margin: 0;
  }

  .stat {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.35rem;
    background: var(--bg);
    padding: var(--space-3) var(--space-2);
    text-align: center;
  }

  dd {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.75rem, 3.5vw, 2.6rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
    color: var(--accent);
    text-wrap: balance;
  }

  dt {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
    text-wrap: balance;
  }

  /* Stack vertically on narrow screens so odd item counts
     don't leave an empty grid cell showing the divider color. */
  @media (max-width: 30rem) {
    .stat-strip {
      grid-template-columns: 1fr;
    }
  }
</style>
