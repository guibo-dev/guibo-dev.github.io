---
interface Props {
  items: { value: string; label: string }[];
}
const { items } = Astro.props;
---

<div class="stat-strip">
  <dl class="container" style={`--cols: ${items.length};`}>
    {
      items.map((item) => (
        <div class="stat" data-reveal>
          <dt>{item.label}</dt>
          <dd>{item.value}</dd>
        </div>
      ))
    }
  </dl>
</div>

<style>
  /* Full-bleed rules, container-aligned content */
  .stat-strip {
    border-block: 1px solid var(--line);
  }

  dl {
    display: grid;
    grid-template-columns: repeat(var(--cols), 1fr);
    /* block only — .container owns the inline margins that center it */
    margin-block: 0;
  }

  .stat {
    position: relative;
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.6rem;
    padding: var(--space-4) clamp(1.25rem, 2.5vw, 2rem);
  }

  /* First column aligns with the page's text edge */
  .stat:first-child {
    padding-left: 0;
  }

  /* Inset hairline dividers between cells */
  .stat:not(:first-child)::before {
    content: '';
    position: absolute;
    left: 0;
    top: 22%;
    bottom: 22%;
    width: 1px;
    background: var(--line);
  }

  dd {
    margin: 0;
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-weight: 600;
    font-size: var(--text-stat);
    font-variant-numeric: tabular-nums;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--accent);
    text-wrap: balance;
  }

  dt {
    font-size: 0.74rem;
    font-weight: 650;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-soft);
    text-wrap: balance;
  }

  /* Two-up grid on small screens; an odd last item spans the full row */
  @media (max-width: 44rem) {
    dl {
      grid-template-columns: repeat(2, 1fr);
    }

    .stat {
      padding: var(--space-3) var(--space-2);
    }

    .stat:nth-child(odd) {
      padding-left: 0;
    }

    .stat:nth-child(odd)::before {
      display: none;
    }

    .stat:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }

    .stat:last-child:nth-child(odd) {
      grid-column: span 2;
    }
  }
</style>
