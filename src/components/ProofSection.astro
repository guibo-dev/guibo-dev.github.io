---
/**
 * Proof, one row per platform in fixed order — X, Instagram, YouTube,
 * LinkedIn, Facebook — with compact columns so a platform's posts share a
 * row. A link may carry a `heading`, rendered as a sub-heading above its
 * platform's row. Anything without a native embed stays a link chip.
 * Consumes the same link_list data as before — no content changes needed.
 */
import EvidenceEmbed from './EvidenceEmbed.astro';
import LinkList from './LinkList.astro';

interface ProofLink {
  label: string;
  url?: string;
  heading?: string;
}

interface Props {
  links: ProofLink[];
  /** Section heading; defaults to "Proof". */
  title?: string;
  /** Intro line under the heading; pages can override via proof_lede. */
  lede?: string;
}
const {
  links,
  title = 'Proof',
  lede = 'See it for yourself — coverage, posts, and reactions from the campaign.',
} = Astro.props;

// Fixed row order. Audio players (Spotify + Apple) precede video.
const PLATFORMS = [
  { name: 'x', test: (u: string) => /^https?:\/\/(www\.)?(x\.com|twitter\.com)\/[^/]+\/status\//.test(u) },
  { name: 'instagram', test: (u: string) => /instagram\.com\//.test(u) },
  { name: 'spotify', test: (u: string) => /open\.spotify\.com\//.test(u) },
  { name: 'apple', test: (u: string) => /podcasts\.apple\.com\//.test(u) },
  { name: 'youtube', test: (u: string) => /youtube\.com\/(watch|playlist)|youtu\.be\//.test(u) },
  { name: 'linkedin', test: (u: string) => /linkedin\.com\/posts\/.*(ugcPost|activity)-\d+/.test(u) },
  { name: 'facebook', test: (u: string) => /facebook\.com\/.+\/posts\//.test(u) },
] as const;

const platformOf = (url?: string) => (url ? PLATFORMS.find((p) => p.test(url))?.name : undefined);

let embedGroups: { name: string; items: ProofLink[] }[] = PLATFORMS.map((p) => ({
  name: p.name as string,
  items: links.filter((l) => platformOf(l.url) === p.name),
})).filter((g) => g.items.length > 0);

// When a page has both Instagram posts and a YouTube video, fold the video
// into the Instagram grid so it fills the space beside a trailing odd post.
const ig = embedGroups.find((g) => g.name === 'instagram');
const yt = embedGroups.find((g) => g.name === 'youtube');
if (ig && yt) {
  ig.items = [...ig.items, ...yt.items];
  embedGroups = embedGroups.filter((g) => g.name !== 'youtube');
}

// X posts and Facebook posts (both short social posts) share one row.
const xGroup = embedGroups.find((g) => g.name === 'x');
const fbGroup = embedGroups.find((g) => g.name === 'facebook');
if (xGroup && fbGroup) {
  xGroup.items = [...xGroup.items, ...fbGroup.items];
  embedGroups = embedGroups.filter((g) => g.name !== 'facebook');
}

// Spotify + Apple players share one "audio" row, in place of the first.
const audioIdx = embedGroups.findIndex((g) => g.name === 'spotify' || g.name === 'apple');
if (audioIdx !== -1) {
  const audioItems = embedGroups
    .filter((g) => g.name === 'spotify' || g.name === 'apple')
    .flatMap((g) => g.items);
  embedGroups = embedGroups.filter((g) => g.name !== 'spotify' && g.name !== 'apple');
  embedGroups.splice(audioIdx, 0, { name: 'audio', items: audioItems });
}

const chips = links.filter((l) => !platformOf(l.url));
---

<section class="proof" aria-label={title}>
  <h3>{title}</h3>
  <p class="lede">{lede}</p>
  {
    embedGroups.map((group) => {
      const rowHeading = group.items.find((l) => l.heading)?.heading;
      return (
        <>
          {rowHeading && <h4 class="row-heading">{rowHeading}</h4>}
          <div class:list={['embeds', `embeds-${group.name}`]}>
            {group.items.map((link) => (
              <EvidenceEmbed url={link.url!} label={link.label} />
            ))}
          </div>
        </>
      );
    })
  }
  {chips.length > 0 && <LinkList links={chips} heading="" />}
</section>

<style>
  /* Hairline-topped section so proof reads as a destination, not a footnote */
  .proof {
    margin-block: var(--space-5) var(--space-4);
    border-top: 1px solid var(--line);
    padding-top: var(--space-4);
  }

  h3 {
    font-size: var(--text-block);
    margin-bottom: 0.35rem;
  }

  .lede {
    font-size: 0.95rem;
    color: var(--ink-soft);
    margin-bottom: var(--space-3);
  }

  .row-heading {
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: normal;
    color: var(--ink);
    margin: var(--space-3) 0 0.7rem;
  }

  /* First sub-heading sits close under the lede */
  .lede + .row-heading {
    margin-top: 0;
  }

  /* Compact columns: ~quarter-width tracks so a platform's posts share a
     row; auto-fill keeps lone embeds small instead of stretching. */
  .embeds {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(15rem, 100%), 1fr));
    gap: var(--space-2);
    align-items: start;
    margin-bottom: 0.4rem;
  }

  /* A YouTube video folded into the Instagram grid fills the row's
     remaining width beside the trailing post */
  .embeds-instagram :global(.evidence-embed.youtube) {
    grid-column: 1 / -1;
  }

  @media (min-width: 64rem) {
    .embeds-instagram :global(.evidence-embed.youtube) {
      grid-column: span 3;
    }
  }

  /* Instagram frames reflow to ~254px via zoom (326px floor × 0.78) */
  .embeds-instagram {
    grid-template-columns: repeat(auto-fill, minmax(min(15.5rem, 100%), 1fr));
  }

  .embeds-linkedin {
    grid-template-columns: repeat(auto-fill, minmax(min(18rem, 100%), 1fr));
  }

  /* Standalone video row: up to three equal players across, so five videos
     read as a 3 + 2 layout on desktop. Each keeps a 16:9 frame. */
  .embeds-youtube {
    grid-template-columns: 1fr;
  }

  @media (min-width: 40rem) {
    .embeds-youtube {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .embeds-youtube {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Spotify + Apple players side by side */
  .embeds-audio {
    grid-template-columns: 1fr;
  }

  @media (min-width: 40rem) {
    .embeds-audio {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* The nested chip list needs no extra section spacing of its own */
  .proof :global(.link-list) {
    margin-block: 0;
  }
</style>
