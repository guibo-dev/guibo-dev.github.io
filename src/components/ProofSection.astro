---
/**
 * Proof, ranked by evidential weight: native social embeds first (X,
 * Instagram, LinkedIn posts), then link chips for everything else
 * (Facebook, YouTube, publications, listens). Consumes the same
 * link_list data as before — no content changes needed.
 */
import EvidenceEmbed from './EvidenceEmbed.astro';
import LinkList from './LinkList.astro';

interface Props {
  links: { label: string; url?: string }[];
}
const { links } = Astro.props;

const isX = (url?: string) =>
  !!url && /^https?:\/\/(www\.)?(x\.com|twitter\.com)\/[^/]+\/status\//.test(url);
const isInstagram = (url?: string) => !!url && /instagram\.com\/(p|reel)\//.test(url);
const isLinkedIn = (url?: string) =>
  !!url && /linkedin\.com\/posts\/.*(ugcPost|activity)-\d+/.test(url);
const isYouTube = (url?: string) => !!url && /(youtube\.com|youtu\.be)/.test(url);

// One row per platform, in fixed order: X → Instagram → LinkedIn
const embedGroups = [
  links.filter((l) => isX(l.url)),
  links.filter((l) => isInstagram(l.url)),
  links.filter((l) => isLinkedIn(l.url)),
].filter((group) => group.length > 0);

// Remaining links as chips, YouTube first
const rest = links.filter((l) => !isX(l.url) && !isInstagram(l.url) && !isLinkedIn(l.url));
const chips = [...rest.filter((l) => isYouTube(l.url)), ...rest.filter((l) => !isYouTube(l.url))];
---

<section class="proof" aria-label="Proof">
  <h3>Proof</h3>
  <p class="lede">See it for yourself — coverage, posts, and reactions from the campaign.</p>
  {
    embedGroups.map((group) => (
      <div class="embeds">
        {group.map((link) => (
          <EvidenceEmbed url={link.url!} label={link.label} />
        ))}
      </div>
    ))
  }
  {chips.length > 0 && <LinkList links={chips} heading="" />}
</section>

<style>
  /* Hairline-topped section so proof reads as a destination, not a footnote */
  .proof {
    margin-block: var(--space-5) var(--space-4);
    border-top: 1px solid var(--line);
    padding-top: var(--space-4);
  }

  h3 {
    font-size: var(--text-block);
    margin-bottom: 0.35rem;
  }

  .lede {
    font-size: 0.95rem;
    color: var(--ink-soft);
    margin-bottom: var(--space-3);
  }

  .embeds {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(22rem, 100%), 1fr));
    gap: var(--space-3);
    align-items: start;
    margin-bottom: var(--space-3);
  }

  /* The nested chip list needs no extra section spacing of its own */
  .proof :global(.link-list) {
    margin-block: 0;
  }
</style>
