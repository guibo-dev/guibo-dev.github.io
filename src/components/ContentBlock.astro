---
interface Props {
  heading?: string;
  body?: string;
  bullets?: string[];
  /** Labeled term + detail entries (e.g. a program/agenda). */
  entries?: { term: string; detail: string }[];
  badge?: string;
  /** Marks the payoff block (Impact) with an accent keyline. */
  emphasis?: boolean;
}
const { heading, body, bullets, entries, badge, emphasis = false } = Astro.props;

// Body strings may hold multiple paragraphs separated by blank lines.
const paragraphs = body
  ? body
      .split(/\n\s*\n/)
      .map((p) => p.trim())
      .filter(Boolean)
  : [];

const hasContent =
  paragraphs.length > 0 ||
  (bullets && bullets.length > 0) ||
  (entries && entries.length > 0) ||
  Astro.slots.has('default');
---

{
  hasContent && (
    <section class:list={['content-block', { emphasis }]}>
      {heading && (
        <h2>
          {heading}
          {badge && <span class="badge">{badge}</span>}
        </h2>
      )}
      <div class="block-body">
        {paragraphs.map((p) => (
          <p>{p}</p>
        ))}
        {bullets && bullets.length > 0 && (
          <ul>
            {bullets.map((b) => (
              <li>{b}</li>
            ))}
          </ul>
        )}
        {entries && entries.length > 0 && (
          <dl class="entries">
            {entries.map((e) => (
              <div class="entry">
                <dt>{e.term}</dt>
                <dd>{e.detail}</dd>
              </div>
            ))}
          </dl>
        )}
        <slot />
      </div>
    </section>
  )
}

<style>
  .content-block {
    margin-block: var(--space-4);
  }

  /* Editorial rail on wide screens: heading in a fixed left column,
     content right — one consistent scan line down every case study. */
  @media (min-width: 64rem) {
    .content-block {
      display: grid;
      grid-template-columns: 13rem minmax(0, 1fr);
      column-gap: var(--space-4);
      align-items: start;
    }

    h2 {
      margin-bottom: 0;
      position: sticky;
      top: var(--space-3);
    }
  }

  h2 {
    font-size: 1.3rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .block-body > :global(:last-child) {
    margin-bottom: 0;
  }

  /* Accent keyline marks the payoff block: full-basis forces its own
     flex row, max-width keeps the painted bar short. */
  .emphasis h2::before {
    content: '';
    display: block;
    flex-basis: 100%;
    max-width: 2rem;
    height: 3px;
    background: var(--accent);
    border-radius: 2px;
    margin-bottom: 0.1rem;
  }

  .badge {
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fff;
    background: var(--accent);
    border-radius: 999px;
    padding: 0.3rem 0.8rem;
    white-space: nowrap;
  }

  p,
  ul {
    font-size: 1.02rem;
  }

  /* Labeled entries: term in accent, detail beneath */
  .entries {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .entry dt {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.3rem;
  }

  .entry dd {
    margin: 0;
    font-size: 1.02rem;
  }
</style>
