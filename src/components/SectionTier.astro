---
interface Props {
  title: string;
  id?: string;
  /** Featured tiers render larger, two-up cards. */
  featured?: boolean;
}
const { title, id, featured = false } = Astro.props;
---

<section class:list={['tier', { featured }]} id={id} aria-label={title}>
  <h3 class="tier-title">{title}</h3>
  <div class="cards">
    <slot />
  </div>
</section>

<style>
  .tier {
    margin-block: var(--space-4);
  }

  .tier-title {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-size: var(--text-block);
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--ink);
    border-bottom: 1px solid var(--line);
    padding-bottom: 0.6rem;
    margin-bottom: var(--space-3);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    gap: var(--space-3);
  }

  /* Flagship work reads bigger: two-up on desktop */
  .tier.featured .cards {
    grid-template-columns: repeat(auto-fill, minmax(min(24rem, 100%), 1fr));
    gap: var(--space-4);
  }
</style>
