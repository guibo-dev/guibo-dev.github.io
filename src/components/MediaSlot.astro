---
import Placeholder from './Placeholder.astro';
import { findPublicImage, findPublicVideo } from '../lib/media';

interface Props {
  folder: string;
  file: string;
  alt: string;
  label?: string;
  /** Optional second caption line beneath the label. */
  description?: string;
  type?: 'image' | 'video';
  ratio?: string;
  loading?: 'lazy' | 'eager';
}

const { folder, file, alt, label, description, type = 'image', ratio, loading = 'lazy' } =
  Astro.props;

const src = type === 'video' ? findPublicVideo(folder, file) : findPublicImage(folder, file);
const purpose = `${type} — ${alt}`;
---

<figure class="media-slot">
  {
    src ? (
      type === 'video' ? (
        <video src={src} controls preload="metadata" aria-label={alt} />
      ) : (
        <img src={src} alt={alt} loading={loading} decoding="async" style={ratio ? `aspect-ratio: ${ratio}; object-fit: cover; width: 100%;` : undefined} />
      )
    ) : (
      <Placeholder name={file} purpose={purpose} ratio={ratio} />
    )
  }
  {
    (label || description) && (
      <figcaption>
        {label && <span class="cap-label">{label}</span>}
        {description && <span class="cap-desc">{description}</span>}
      </figcaption>
    )
  }
</figure>

<style>
  .media-slot {
    margin: 0;
  }

  img,
  video {
    width: 100%;
    border-radius: var(--radius);
  }

  figcaption {
    margin-top: 0.5rem;
  }

  .cap-label {
    display: block;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--ink);
  }

  .cap-desc {
    display: block;
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--ink-soft);
    margin-top: 0.2rem;
  }

  /* When there's no description, the label alone keeps the muted caption look */
  .cap-label:only-child {
    font-weight: 500;
    color: var(--ink-soft);
  }
</style>
