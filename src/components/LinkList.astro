---
interface Props {
  heading?: string;
  links: { label: string; url?: string }[];
}
const { heading = 'Proof', links } = Astro.props;
---

{
  links.length > 0 && (
    <section class="link-list" aria-label={heading}>
      <h3>{heading}</h3>
      <ul>
        {links.map((link) =>
          link.url ? (
            <li>
              <a class="chip" href={link.url} target="_blank" rel="noopener noreferrer">
                {link.label}
                <span aria-hidden="true">↗</span>
              </a>
            </li>
          ) : (
            <li>
              <span class="chip pending">
                {link.label}
                <span class="todo-note">TODO: add URL</span>
              </span>
            </li>
          )
        )}
      </ul>
    </section>
  )
}

<style>
  .link-list {
    margin-block: var(--space-4);
  }

  h3 {
    font-size: 1.1rem;
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    max-width: none;
  }

  li {
    margin: 0;
  }

  /* Shares chip metrics with PartnerTags for one coherent chip family */
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.85rem;
    font-weight: 550;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.4rem 1rem;
    text-decoration: none;
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  a.chip:hover {
    border-color: var(--accent);
    color: var(--accent-dark);
  }

  .chip.pending {
    color: var(--ink-soft);
    border-style: dashed;
  }
</style>
