---
interface Props {
  tags: string[];
}
const { tags } = Astro.props;
---

{
  tags.length > 0 && (
    <section class="partner-tags" aria-label="Partners">
      <h3>Partners</h3>
      <ul>
        {tags.map((tag) => (
          <li>{tag}</li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .partner-tags {
    margin-block: var(--space-4);
  }

  h3 {
    font-size: 1.1rem;
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    max-width: none;
  }

  li {
    margin: 0;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--ink-soft);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.3rem 0.9rem;
  }
</style>
